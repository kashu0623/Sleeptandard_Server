DATABASE_URL=postgresql+psycopg://wearable:wearable@localhost:5432/wearable_sleep
APP_NAME=Wearable Sleep API
APP_ENV=local
LOG_LEVEL=INFO
LOG_SERVICE_NAME=sleeptandard-api
LOG_HEALTH_REQUESTS=false
API_KEY=local-dev-api-key
ACCESS_TOKEN_SECRET_KEY=local-dev-access-token-secret-change-me
ACCESS_TOKEN_EXPIRES_MINUTES=10080
AWS_REGION=ap-northeast-2
# Leave AWS credentials unset in Elastic Beanstalk. The server uses its IAM role.
AWS_S3_ENDPOINT_URL=
S3_BUCKET_NAME=wearable-sleep-local
S3_UPLOAD_URL_EXPIRES_SEC=900
S3_MULTIPART_BACKEND=local
PUBLIC_BASE_URL=http://127.0.0.1:8000
